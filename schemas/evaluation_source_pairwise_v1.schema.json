{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vpick source-conditioned pairwise judgment v1",
  "type": "object",
  "required": ["pair_id", "winner", "comparison", "confidence_1_5", "reason"],
  "additionalProperties": false,
  "properties": {
    "pair_id": {"type": "string", "minLength": 1},
    "winner": {"enum": ["A", "B", "tie", "invalid"]},
    "comparison": {
      "type": "object",
      "required": ["source_salience", "standalone_quality", "boundary_integrity"],
      "additionalProperties": false,
      "properties": {
        "source_salience": {"$ref": "#/$defs/preference"},
        "standalone_quality": {"$ref": "#/$defs/preference"},
        "boundary_integrity": {"$ref": "#/$defs/preference"}
      }
    },
    "confidence_1_5": {"type": "integer", "minimum": 1, "maximum": 5},
    "reason": {"type": "string"}
  },
  "$defs": {
    "preference": {"enum": ["A", "B", "tie", "invalid"]}
  }
}
