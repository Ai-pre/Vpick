{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vpick source-conditioned pointwise judgment v1",
  "type": "object",
  "required": [
    "candidate_id",
    "verdict",
    "scores",
    "confidence_1_5",
    "failure_flags",
    "reason"
  ],
  "additionalProperties": false,
  "properties": {
    "candidate_id": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["score", "abstain"]},
    "scores": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": [
            "source_salience",
            "relative_competitiveness",
            "hook",
            "self_contained",
            "payoff",
            "density",
            "boundary"
          ],
          "additionalProperties": false,
          "properties": {
            "source_salience": {"$ref": "#/$defs/dimension"},
            "relative_competitiveness": {"$ref": "#/$defs/dimension"},
            "hook": {"$ref": "#/$defs/dimension"},
            "self_contained": {"$ref": "#/$defs/dimension"},
            "payoff": {"$ref": "#/$defs/dimension"},
            "density": {"$ref": "#/$defs/dimension"},
            "boundary": {"$ref": "#/$defs/dimension"}
          }
        }
      ]
    },
    "confidence_1_5": {"type": "integer", "minimum": 1, "maximum": 5},
    "failure_flags": {"type": "array", "items": {"type": "string"}},
    "reason": {"type": "string"}
  },
  "$defs": {
    "dimension": {
      "type": "object",
      "required": ["score", "reason"],
      "additionalProperties": false,
      "properties": {
        "score": {"type": "integer", "minimum": 0, "maximum": 4},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
